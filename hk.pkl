amends "package://github.com/jdx/hk/releases/download/v2.2.0/hk@2.2.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.2.0/hk@2.2.0#/Builtins.pkl"

// Checks for a Terraform provider written in Go.
//
// `fix` steps rewrite files (gofmt -w, golangci-lint --fix); `check` steps only
// report. hk coordinates access to each file so parallel fixers cannot clobber
// one another, which is the reason to use it over a pre-commit shell script.
//
// Tools come from mise.toml, so `mise install` is the only setup step.

local go_checks = new Mapping<String, Step> {
  ["go_fmt"] = Builtins.go_fmt
  ["go_vet"] = Builtins.go_vet
  ["golangci_lint"] = Builtins.golangci_lint
}

local repo_checks = new Mapping<String, Step> {
  ["trailing_whitespace"] = Builtins.trailing_whitespace
  ["detect_private_key"] = Builtins.detect_private_key
  ["gitleaks"] = new Step {
    // Scans for committed secrets. A Terraform provider handles credentials, so
    // its test fixtures are exactly where a stray token would end up.
    glob = List("**/*")
    check = "gitleaks detect --no-banner --redact --source ."
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = go_checks
  }
  ["check"] {
    steps = go_checks
  }
  ["fix"] {
    fix = true
    steps = go_checks
  }
}

// Whole-repo checks: they need the full tree rather than a file list, so they
// are separate hooks invoked deliberately rather than on every commit.
hooks {
  ["pre-push"] {
    steps = repo_checks
  }
}
